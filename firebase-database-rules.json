{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() ? newData.child('hostUid').val() == auth.uid : data.child('hostUid').val() == auth.uid)",
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid == $uid || auth.uid == root.child('rooms').child($roomId).child('hostUid').val())"
          }
        },
        "actions": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('rooms').child($roomId).child('players').child(auth.uid).exists()",
            "$actionId": {
              ".validate": "newData.child('uid').val() == auth.uid && newData.child('actionId').val() == $actionId"
            }
          }
        },
        "actionResults": {
          "$uid": {
            "$actionId": {
              ".write": "auth != null && auth.uid == root.child('rooms').child($roomId).child('hostUid').val()",
              ".read": "auth != null && (auth.uid == $uid || auth.uid == root.child('rooms').child($roomId).child('hostUid').val())"
            }
          }
        }
      }
    },
    "privateCards": {
      "$roomId": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && (auth.uid == $uid || auth.uid == root.child('rooms').child($roomId).child('hostUid').val())",
          ".validate": "auth.uid == root.child('rooms').child($roomId).child('hostUid').val() || newData.child('cardName').val() == null"
        }
      }
    },
    "freeMatchQueue": {
      ".read": "auth != null",
      "$mode": {
        ".read": "auth != null",
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren([\"uid\",\"name\",\"joinedAt\",\"mode\"]) && newData.child(\"uid\").val() == auth.uid && newData.child(\"mode\").val() == $mode && newData.child(\"joinedAt\").isNumber() && newData.child(\"name\").isString() && newData.child(\"name\").val().length <= 12"
        }
      }
    }
  }
}
